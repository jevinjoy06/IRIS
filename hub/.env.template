# IRIS Hub — copy to hub/.env and fill in values

# Ollama endpoint (default: local Ollama on port 11434)
OLLAMA_BASE_URL=http://localhost:11434/v1

# Model to use. llama3.1:8b is a solid default; qwen2.5:14b is stronger on tool use.
OLLAMA_MODEL=llama3.1:8b

# Optional: Tavily API key for web_search tool (get free key at tavily.com)
TAVILY_API_KEY=

# Hub network settings
HUB_HOST=0.0.0.0
HUB_PORT=7865

# Filesystem sandbox root (defaults to hub/workspace/ if not set)
FILE_SYSTEM_ROOT=
